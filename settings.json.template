{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PAI_DIR": "/home/YOUR_USERNAME/.claude",
    "PROJECTS_DIR": "${HOME}/Projects"
  },
  "permissions": {
    "allow": [
      "Bash", "Read", "Write", "Edit", "Glob", "Grep",
      "WebFetch", "WebSearch", "Task", "Skill", "mcp__*"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "_comment": "See hooks/ directory for available lifecycle handlers. Copy configurations as needed."
  }
}
